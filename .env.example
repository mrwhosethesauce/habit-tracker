# MongoDB Atlas connection string (include the database name in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/habit-tracker?retryWrites=true&w=majority

# JWT signing secret — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# JWT expiry (any `ms`-compatible string)
JWT_EXPIRES_IN=7d

# Resend API key (resend.com -> API Keys) — sends password-reset emails
RESEND_API_KEY=re_your_api_key

# Optional: "Name <email>" the reset email is sent from. Defaults to
# Resend's onboarding@resend.dev sandbox address, which works without a
# verified domain but only delivers to the email the Resend account itself
# signed up with.
# RESEND_FROM_EMAIL=Habit Tracker <onboarding@resend.dev>

# Optional: public URL of the frontend, used to build the reset-password
# link. Only needed when the frontend and API aren't on the same origin
# (e.g. local dev: Vite on :5173, API on :3000) — in production, on
# Vercel, this is inferred from the request automatically.
# APP_URL=http://localhost:5173
