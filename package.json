{
  "name": "habit-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Habit Tracker with Streaks & Analytics — MERN, deployed as a single Vercel project (api/ = serverless functions).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vercel dev",
    "dev:api": "node scripts/dev-server.js",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "vercel": "^37.0.0",
    "vitest": "^2.0.5"
  }
}
